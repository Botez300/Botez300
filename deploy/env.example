# Legion environment template. NO secrets belong in this file or in config.json.
# Robinhood OAuth tokens live in the OS credential store (python -m legion.rh_auth login).
LEGION_RH_MCP_URL=https://agent.robinhood.com/mcp/trading
LEGION_MODE=PAPER
# Google Drive API (only if source=api): paths to files OUTSIDE the repository
# LEGION_GOOGLE_OAUTH_TOKEN_FILE=C:\Users\<you>\.legion\drive_token.json
TZ=America/New_York
