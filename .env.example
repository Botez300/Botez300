# Copy to .env. Nothing here is a real secret; replace every value marked CHANGE before deploying.

ENV=dev                                   # dev | test | prod
POSTGRES_PASSWORD=legion                  # CHANGE in any shared environment
DATABASE_URL=postgresql+psycopg://legion:legion@localhost:5432/legion
REDIS_URL=redis://localhost:6379/0        # optional: shared login rate limiting
JWT_SECRET=dev-only-secret-change-me-dev-only-secret   # CHANGE: `openssl rand -hex 32`. prod refuses the default.
COOKIE_SECURE=false                       # must be true in prod (HTTPS)
CORS_ORIGINS=http://localhost:3000

# Market data. `demo` serves clearly labelled synthetic data and needs no credentials.
DATA_PROVIDER=demo                        # demo | alpaca | polygon
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_FEED=iex                           # iex | sip (per your Alpaca plan)
POLYGON_API_KEY=
POLYGON_BASE_URL=https://api.polygon.io   # Massive customers: set the base URL from your account docs

# Web (build-time): where the Next.js server proxies /api to.
API_URL=http://localhost:8000
